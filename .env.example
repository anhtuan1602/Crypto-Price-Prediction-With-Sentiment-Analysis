# Copy to .env and fill in. Never commit .env.

# --- Sentiment -----------------------------------------------------------
# Gemini key from https://aistudio.google.com/apikey . Leave empty to use the
# offline lexicon backend (weaker, but the pipeline still runs).
# The key is sent in a request header and is redacted from logs.
GEMINI_API_KEY=
# Works on the free tier. If a model answers 404 the client falls back to
# gemini-flash-latest and then to other Flash models your key lists.
GEMINI_MODEL=gemini-3.5-flash-lite
# requests per minute your key allows (free tier is low; raise on a paid key)
GEMINI_RPM=10
# articles scored per request (fewer requests = more articles per daily quota)
GEMINI_BATCH_SIZE=10
# lexicon-scored articles upgraded to Gemini per hour by sentiment_catchup_1h (0 = off)
GEMINI_RESCORE_PER_HOUR=50
# auto | gemini | lexicon | finbert
#   auto: Gemini if the key works, else lexicon (one clear error in the log)
#   gemini: Gemini or fail the task
SENTIMENT_BACKEND=auto

# --- News sources ----------------------------------------------------------
NEWS_SOURCES=coinmarketcap,rss
# historical backfill: GDELT is free (no key, about the last 3 months, headlines only);
# cryptocompare is used only if a key is set (CoinDesk Data ended its free tier in May 2026)
NEWS_BACKFILL_SOURCES=gdelt,cryptocompare
# download the article page once when a feed only has a teaser
FETCH_FULL_TEXT=true
# extra RSS feeds as name=url pairs, and feed names to switch off
RSS_FEEDS_EXTRA=
RSS_FEEDS_DISABLED=
# training data starts at: auto (first live crawl), all, or an ISO time like 2026-11-26T18:00:00Z
TRAIN_START=auto
CRYPTOCOMPARE_API_KEY=
# optional comma-separated proxy pool, e.g. http://user:pass@host:port,http://...
HTTP_PROXY_POOL=

# --- Market data -----------------------------------------------------------
SYMBOL=BTCUSDT
# data-api.binance.vision is Binance's public market-data mirror
BINANCE_BASE_URL=https://data-api.binance.vision

# --- Temporal framework (minutes, report section 3.1) ---------------------
WINDOW_OBS_MIN=30
WINDOW_LAG_MIN=10
WINDOW_PRED_MIN=10
WINDOW_STEP_MIN=10

# --- Evaluation ----------------------------------------------------------
TARGET_FLAT_THRESHOLD_PCT=0.02
BACKTEST_FEE_PCT=0.1

# --- Airflow -------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me-too

# --- Local (non-Docker) runs only ------------------------------------------
# MONGO_URI=mongodb://localhost:27017
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# MLFLOW_TRACKING_URI=http://localhost:5000
DATA_DIR=data
ARTIFACTS_DIR=artifacts
